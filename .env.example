# Copie para .env.local e preencha. NUNCA commite valores reais.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site (canonical, sitemap, Open Graph). Ex.: https://jenniferestetica.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anti-spam da triagem pública (Cloudflare Turnstile, plano gratuito). OPCIONAL: sem as chaves fica desligado.
# Ativar ANTES de divulgar o link da triagem amplamente. Crie o widget em https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Somente desenvolvimento SEM Supabase: senha do admin local (/admin/login).
# Ignorada em produção. Sem Supabase configurado, o app usa um Postgres local (.data/pgdata).
ADMIN_LOCAL_PASSWORD=
